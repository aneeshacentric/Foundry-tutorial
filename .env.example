# Azure AI Foundry project connection
# Found in the Foundry portal: Project > Overview > "Project endpoint"
# Looks like: https://<your-resource>.services.ai.azure.com/api/projects/<your-project>
PROJECT_ENDPOINT=

# Name of the model deployment (e.g. gpt-4o) used when creating a new agent
MODEL_DEPLOYMENT_NAME=gpt-4o

# Name of an existing Foundry agent to call (NOT a GUID — the agent's "name",
# e.g. "careful-agent-82lybqkdrb"). Leave blank to create a new agent each run.
AGENT_NAME=

# Optional: API key for key-based auth (alternative to DefaultAzureCredential).
# Found on the Foundry resource's "Keys and Endpoint" page in the portal.
# Only works if the target agent's authorization_schemes includes "ApiKey".
FOUNDRY_API_KEY=
